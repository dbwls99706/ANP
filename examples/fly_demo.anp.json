{
  "version": "0.1",
  "metadata": {
    "name": "anp-demo",
    "description": "ANP live demo — REST API with path parameters, running on Fly.io"
  },
  "nodes": [
    {
      "id": "server",
      "node_type": "http_server",
      "kind": "service",
      "config": {
        "port": 8080,
        "routes": [
          { "path": "/", "method": "GET", "output_port": "home" },
          { "path": "/users", "method": "GET", "output_port": "list_users" },
          { "path": "/users/:id", "method": "GET", "output_port": "get_user" },
          { "path": "/users", "method": "POST", "output_port": "create_user" }
        ]
      },
      "outputs": [
        { "name": "home" },
        { "name": "list_users" },
        { "name": "get_user" },
        { "name": "create_user" }
      ]
    },
    {
      "id": "home_page",
      "node_type": "html_template",
      "kind": "processor",
      "config": {
        "html": "<!DOCTYPE html><html><head><meta charset='UTF-8'><title>ANP Demo</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:-apple-system,sans-serif;background:#0f0f23;color:#e2e8f0;display:flex;justify-content:center;align-items:center;min-height:100vh}.container{max-width:600px;padding:40px;text-align:center}h1{font-size:2.5rem;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:8px}p.sub{color:#94a3b8;margin-bottom:32px}code{background:rgba(255,255,255,0.1);padding:12px 20px;border-radius:8px;display:block;margin:8px 0;text-align:left;font-size:0.9rem;color:#a5b4fc}.endpoints{text-align:left;margin-top:24px}.ep{padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.1)}.method{font-weight:bold;color:#667eea;margin-right:8px}.badge{font-size:0.7rem;background:rgba(102,126,234,0.2);color:#667eea;padding:2px 8px;border-radius:4px;margin-left:8px}</style></head><body><div class='container'><h1>ANP Demo</h1><p class='sub'>This REST API is defined as a graph — zero lines of code.</p><div class='endpoints'><div class='ep'><span class='method'>GET</span>/users<span class='badge'>list all</span></div><div class='ep'><span class='method'>GET</span>/users/:id<span class='badge'>get one</span></div><div class='ep'><span class='method'>POST</span>/users<span class='badge'>create</span></div></div><p style='margin-top:32px;color:#64748b;font-size:0.85rem'>Powered by ANP — AI Native Programming</p></div></body></html>"
      },
      "inputs": [{ "name": "default" }],
      "outputs": [{ "name": "default" }]
    },
    {
      "id": "db",
      "node_type": "database",
      "kind": "processor",
      "config": {
        "initial": {
          "user:1": { "id": 1, "name": "Alice", "email": "alice@example.com" },
          "user:2": { "id": 2, "name": "Bob", "email": "bob@example.com" },
          "user:3": { "id": 3, "name": "Charlie", "email": "charlie@example.com" }
        }
      },
      "inputs": [{ "name": "default" }],
      "outputs": [{ "name": "default" }]
    }
  ],
  "edges": [
    { "id": "e1", "from_node": "server", "from_port": "home", "to_node": "home_page" },
    { "id": "e2", "from_node": "server", "from_port": "list_users", "to_node": "db" },
    { "id": "e3", "from_node": "server", "from_port": "get_user", "to_node": "db" },
    { "id": "e4", "from_node": "server", "from_port": "create_user", "to_node": "db" }
  ]
}
