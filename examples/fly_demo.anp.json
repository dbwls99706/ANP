{
  "version": "0.1",
  "metadata": {
    "name": "anp-demo",
    "description": "ANP live demo — interactive REST API with real-time API calls"
  },
  "nodes": [
    {
      "id": "server",
      "node_type": "http_server",
      "kind": "service",
      "config": {
        "port": 8080,
        "routes": [
          { "path": "/", "method": "GET", "output_port": "home" },
          { "path": "/users", "method": "GET", "output_port": "list_users" },
          { "path": "/users/:id", "method": "GET", "output_port": "get_user" },
          { "path": "/users", "method": "POST", "output_port": "create_user" }
        ]
      },
      "outputs": [
        { "name": "home" },
        { "name": "list_users" },
        { "name": "get_user" },
        { "name": "create_user" }
      ]
    },
    {
      "id": "home_page",
      "node_type": "html_template",
      "kind": "processor",
      "config": {
        "html": "<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>ANP Live Demo</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#0a0a1a;color:#e2e8f0;min-height:100vh}.header{text-align:center;padding:48px 20px 32px;background:linear-gradient(180deg,#1a1040 0%,#0a0a1a 100%)}.header h1{font-size:2.5rem;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:8px}.header p{color:#94a3b8;font-size:1.1rem}.badge{display:inline-block;background:rgba(102,126,234,0.15);color:#667eea;padding:4px 12px;border-radius:20px;font-size:0.8rem;margin-top:12px;border:1px solid rgba(102,126,234,0.3)}.main{max-width:900px;margin:0 auto;padding:0 20px 60px}.section{margin-top:32px}.section h2{font-size:1.3rem;margin-bottom:16px;color:#c4b5fd}.card{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:20px;margin-bottom:12px;transition:border-color 0.2s}.card:hover{border-color:rgba(102,126,234,0.4)}.card-header{display:flex;align-items:center;gap:12px;margin-bottom:12px;cursor:pointer}.method{font-weight:700;font-size:0.85rem;padding:4px 10px;border-radius:6px;font-family:monospace}.method-get{background:rgba(34,197,94,0.15);color:#4ade80}.method-post{background:rgba(234,179,8,0.15);color:#facc15}.path{font-family:monospace;font-size:1rem;color:#e2e8f0}.desc{color:#64748b;font-size:0.85rem;margin-left:auto}.result-box{background:#0f0f23;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:16px;font-family:monospace;font-size:0.85rem;color:#a5b4fc;white-space:pre-wrap;word-break:break-all;max-height:300px;overflow-y:auto;display:none}.result-box.visible{display:block}.loading{color:#667eea;font-style:italic}.error{color:#ef4444}.timer{color:#64748b;font-size:0.75rem;margin-top:8px}.graph-section{margin-top:40px;text-align:center}.graph-section h2{margin-bottom:16px}.graph-box{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:24px;font-family:monospace;font-size:0.9rem;color:#94a3b8;line-height:2}.node{display:inline-block;padding:6px 16px;border-radius:8px;margin:0 4px}.node-service{background:rgba(102,126,234,0.2);color:#667eea;border:1px solid rgba(102,126,234,0.4)}.node-processor{background:rgba(118,75,162,0.2);color:#a78bfa;border:1px solid rgba(118,75,162,0.4)}.arrow{color:#4a5568;margin:0 8px}footer{text-align:center;padding:32px;color:#475569;font-size:0.8rem;border-top:1px solid rgba(255,255,255,0.05)}footer a{color:#667eea;text-decoration:none}footer a:hover{text-decoration:underline}.try-btn{background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;padding:8px 20px;border-radius:8px;font-size:0.85rem;cursor:pointer;font-weight:600;transition:opacity 0.2s}.try-btn:hover{opacity:0.85}.create-form{display:none;margin-top:12px;gap:8px}.create-form.visible{display:flex;flex-wrap:wrap}.create-form input{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);color:#e2e8f0;padding:8px 12px;border-radius:6px;font-size:0.9rem;flex:1;min-width:120px}.create-form input::placeholder{color:#475569}@media(max-width:600px){.header h1{font-size:1.8rem}.desc{display:none}}</style></head><body><div class='header'><h1>ANP Live Demo</h1><p>A REST API defined as an executable graph — zero lines of code</p><div class='badge'>3 nodes &bull; 4 edges &bull; 1 JSON file &bull; Rust runtime</div></div><div class='main'><div class='section'><h2>Try the API</h2><div class='card' id='c1'><div class='card-header' onclick='callApi(\"/users\",\"c1\")'><span class='method method-get'>GET</span><span class='path'>/users</span><span class='desc'>List all users</span><button class='try-btn'>Try it</button></div><div class='result-box' id='r1'></div><div class='timer' id='t1'></div></div><div class='card' id='c2'><div class='card-header' onclick='callApi(\"/users/1\",\"c2\")'><span class='method method-get'>GET</span><span class='path'>/users/1</span><span class='desc'>Get Alice</span><button class='try-btn'>Try it</button></div><div class='result-box' id='r2'></div><div class='timer' id='t2'></div></div><div class='card' id='c3'><div class='card-header' onclick='callApi(\"/users/2\",\"c3\")'><span class='method method-get'>GET</span><span class='path'>/users/2</span><span class='desc'>Get Bob</span><button class='try-btn'>Try it</button></div><div class='result-box' id='r3'></div><div class='timer' id='t3'></div></div><div class='card' id='c4'><div class='card-header' onclick='toggleForm()'><span class='method method-post'>POST</span><span class='path'>/users</span><span class='desc'>Create user</span><button class='try-btn'>Try it</button></div><div class='create-form' id='form'><input id='fname' placeholder='Name (e.g. Dave)'/><input id='femail' placeholder='Email (e.g. dave@test.com)'/><button class='try-btn' onclick='createUser(event)'>Send</button></div><div class='result-box' id='r4'></div><div class='timer' id='t4'></div></div></div><div class='graph-section'><h2>The Graph Behind This API</h2><div class='graph-box'><span class='node node-service'>http_server :8080</span><span class='arrow'>&rarr;</span><span class='node node-processor'>html_template</span><br><span class='node node-service'>http_server :8080</span><span class='arrow'>&rarr;</span><span class='node node-processor'>database (in-memory)</span></div><p style='color:#64748b;font-size:0.85rem;margin-top:16px'>This entire application is a <strong style=\"color:#a5b4fc\">JSON graph</strong> executed by the ANP runtime.<br>No Python. No JavaScript. No compilation. Just a graph.</p></div></div><footer><a href='https://github.com/dbwls99706/ANP' target='_blank'>GitHub</a> &bull; Powered by ANP v0.8 &bull; Rust + Tokio + Axum<br><span style='margin-top:8px;display:block'>Prompt &rarr; Graph &rarr; Verify &rarr; Optimize &rarr; Run</span></footer><script>function callApi(path,cardId){var n=cardId.slice(1);var rb=document.getElementById('r'+n);var tb=document.getElementById('t'+n);rb.className='result-box visible';rb.innerHTML='<span class=\"loading\">Calling '+path+'...</span>';tb.textContent='';var start=performance.now();fetch(path).then(function(r){return r.text()}).then(function(text){var ms=(performance.now()-start).toFixed(1);try{var j=JSON.parse(text);rb.textContent=JSON.stringify(j,null,2)}catch(e){rb.textContent=text}rb.className='result-box visible';tb.textContent='Response time: '+ms+'ms'}).catch(function(e){rb.innerHTML='<span class=\"error\">Error: '+e.message+'</span>';rb.className='result-box visible'})}function toggleForm(){var f=document.getElementById('form');f.className=f.className.indexOf('visible')>=0?'create-form':'create-form visible'}function createUser(ev){ev.stopPropagation();var name=document.getElementById('fname').value||'Dave';var email=document.getElementById('femail').value||'dave@test.com';var rb=document.getElementById('r4');var tb=document.getElementById('t4');rb.className='result-box visible';rb.innerHTML='<span class=\"loading\">Creating user...</span>';var start=performance.now();fetch('/users',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name,email:email})}).then(function(r){return r.text()}).then(function(text){var ms=(performance.now()-start).toFixed(1);try{var j=JSON.parse(text);rb.textContent=JSON.stringify(j,null,2)}catch(e){rb.textContent=text}rb.className='result-box visible';tb.textContent='Response time: '+ms+'ms'}).catch(function(e){rb.innerHTML='<span class=\"error\">Error: '+e.message+'</span>';rb.className='result-box visible'})}</script></body></html>"
      },
      "inputs": [{ "name": "default" }],
      "outputs": [{ "name": "default" }]
    },
    {
      "id": "db",
      "node_type": "database",
      "kind": "processor",
      "config": {
        "initial": {
          "user:1": { "id": 1, "name": "Alice", "email": "alice@example.com", "role": "admin" },
          "user:2": { "id": 2, "name": "Bob", "email": "bob@example.com", "role": "user" },
          "user:3": { "id": 3, "name": "Charlie", "email": "charlie@example.com", "role": "user" }
        }
      },
      "inputs": [{ "name": "default" }],
      "outputs": [{ "name": "default" }]
    }
  ],
  "edges": [
    { "id": "e1", "from_node": "server", "from_port": "home", "to_node": "home_page" },
    { "id": "e2", "from_node": "server", "from_port": "list_users", "to_node": "db" },
    { "id": "e3", "from_node": "server", "from_port": "get_user", "to_node": "db" },
    { "id": "e4", "from_node": "server", "from_port": "create_user", "to_node": "db" }
  ]
}
